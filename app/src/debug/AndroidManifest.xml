<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Certificate AIA, OCSP, and CRL endpoints still require HTTP. The network
         security config also adds the public Telia Root CA v2 the WebView omits. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">

        <!-- DUMP is held by the shell user and the system, so adb shell am broadcast
             reaches the receiver and other apps on the phone do not. -->
        <receiver
            android:name="fi.refineid.android.diagnostics.DiagnosticsDumpReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="fi.refineid.android.DUMP_DIAGNOSTICS" />
                <action android:name="fi.refineid.android.CLEAR_LOGS" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
