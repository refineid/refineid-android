<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Certificate AIA, OCSP, and CRL endpoints still require HTTP. The network
         security config also adds the public Telia Root CA v2 the WebView omits. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic">

        <receiver
            android:name="fi.refineid.android.diagnostics.DiagnosticsDumpReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="fi.refineid.android.DUMP_DIAGNOSTICS" />
                <action android:name="fi.refineid.android.CLEAR_LOGS" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
