# The gates run these through bash and compare these byte for byte, so they
# keep LF on every host, Windows included.
*.sh text eol=lf
.githooks/** text eol=lf
gradlew text eol=lf
*.aidl text eol=lf
app/src/main/java/com/android/keychain/external/*.java text eol=lf

# A Windows batch file keeps the CRLF it is committed with.
gradlew.bat -text
